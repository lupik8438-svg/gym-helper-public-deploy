# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Shared database. Use an absolute path in production if desired.
DATABASE_URL=sqlite:///./fitness_bot.db

# OpenAI API (для распознавания еды)
OPENAI_API_KEY=your_openai_key_here

# Web App
WEBAPP_URL=http://localhost:8081
# Telegram can open only a public HTTPS address, for example a deployed domain or tunnel.
WEBAPP_PUBLIC_URL=https://your-mini-app-domain.example
PUBLIC_SITE_URL=https://your-site-domain.example
WEB_PORT=8081
REQUIRE_WEBAPP_AUTH=True

# Admin dashboard. Never publish this key.
ADMIN_KEY=replace-with-a-long-random-key
ADMIN_SESSION_SECRET=replace-with-another-long-random-key

# Environment
DEBUG=False

# Public website deployment: use a persistent PostgreSQL URL for real data.
# Keep the demo database isolated from private user profiles.
PUBLIC_DEMO_MODE=False
